# Example Configuration for Voice AI Pipeline
# Can point to localhost:11434 or remote Tailscale host (e.g. http://100.x.y.z:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# VAD (Silero) Settings
VAD_DEVICE=cpu
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=0.5

# STT (Whisper) Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS (Kokoro) Settings
KOKORO_VOICE=af_heart
KOKORO_DEVICE=cpu

# Audio Settings
SAMPLE_RATE=16000
